<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
	
<mapper namespace="com.example.unipet.mapper.DefaultMapper">
	<!-- 여러개 검색 -->
	<select id="selectUserList" parameterType="hashmap" resultType="com.example.unipet.model.Default">
	</select>
	
	<!-- 한개 검색 -->
	<select id="selectUser" parameterType="hashmap" resultType="com.example.unipet.model.Default">
	</select>
	
	<!-- 삽입 -->
	<insert id="insertUser" parameterType="hashmap">
	</insert>
	
	<!-- 삭제 -->
	<delete id="deleteUser" parameterType="hashmap">
	</delete>
	
	<!-- 수정 -->
	<update id="updateUser" parameterType="hashmap">
	</update>
	
</mapper>