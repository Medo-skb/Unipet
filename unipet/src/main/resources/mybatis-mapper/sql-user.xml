<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.unipet.mapper.UserMapper">

    <!-- ===================================================== -->
    <!-- User 객체와 DB 컬럼 매핑 -->
    <!-- ===================================================== -->
    <resultMap id="userMap" type="com.example.unipet.model.User">
        <result property="userId" column="user_id"/>
        <result property="pwd" column="pwd"/>
        <result property="userName" column="user_name"/>
        <result property="role" column="role"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="bizName" column="biz_name"/>
        <result property="bizNo" column="biz_no"/>
        <result property="bizStatus" column="biz_status"/>
        <result property="bizFileName" column="biz_file_name"/>
        <result property="bizFilePath" column="biz_file_path"/>
    </resultMap>

    <!-- ===================================================== -->
    <!-- 1. 아이디 중복체크 -->
    <!-- users 테이블에 동일한 아이디가 몇 개 있는지 조회 -->
    <!-- ===================================================== -->
    <select id="checkUser" parameterType="hashmap" resultType="int">
        SELECT COUNT(*)
        FROM users
        WHERE user_id = #{userId}
    </select>

    <!-- ===================================================== -->
    <!-- 2. 일반 회원가입 -->
    <!-- ===================================================== -->
    <insert id="insertUser" parameterType="hashmap">
        INSERT INTO users
        (
            user_id,
            pwd,
            user_name,
            phone,
            email,
            role
        )
        VALUES
        (
            #{userId},
            #{pwd},
            #{userName},
            #{phone},
            #{email},
            #{role}
        )
    </insert>

    <!-- ===================================================== -->
    <!-- 3. 사업자 회원가입 - users 테이블 저장 -->
    <!-- ===================================================== -->
    <insert id="insertBizUser" parameterType="hashmap">
        INSERT INTO users
        (
            user_id,
            pwd,
            user_name,
            phone,
            email,
            role
        )
        VALUES
        (
            #{userId},
            #{pwd},
            #{userName},
            #{phone},
            #{email},
            #{role}
        )
    </insert>

    <!-- ===================================================== -->
    <!-- 4. 사업자 회원가입 - biz_info 테이블 저장 -->
    <!-- ===================================================== -->
    <insert id="insertBizInfo" parameterType="hashmap">
        INSERT INTO biz_info
        (
            user_id,
            biz_name,
            biz_no,
            biz_status,
            biz_file_name,
            biz_file_path
        )
        VALUES
        (
            #{userId},
            #{bizName},
            #{bizNo},
            #{bizStatus},
            #{bizFileName},
            #{bizFilePath}
        )
    </insert>

    <!-- ===================================================== -->
    <!-- 5. 로그인용 사용자 조회 -->
    <!-- users + biz_info LEFT JOIN -->
    <!-- 일반회원도 조회되고, 사업자는 추가정보까지 같이 조회 -->
    <!-- ===================================================== -->
    <select id="selectUser" parameterType="hashmap" resultMap="userMap">
        SELECT
            u.user_id,
            u.pwd,
            u.user_name,
            u.phone,
            u.email,
            u.role,
            b.biz_name,
            b.biz_no,
            b.biz_status,
            b.biz_file_name,
            b.biz_file_path
        FROM users u
        LEFT JOIN biz_info b
               ON u.user_id = b.user_id
        WHERE u.user_id = #{userId}
    </select>

    <!-- ===================================================== -->
    <!-- 6. 아이디 찾기 -->
    <!-- 이름 + 휴대폰번호로 조회 -->
    <!-- ===================================================== -->
    <select id="findId" parameterType="hashmap" resultMap="userMap">
        SELECT
            user_id,
            user_name,
            phone
        FROM users
        WHERE user_name = #{userName}
          AND phone = #{phone}
    </select>

    <!-- ===================================================== -->
    <!-- 7. 비밀번호 찾기용 회원 확인 -->
    <!-- 아이디 + 휴대폰번호로 조회 -->
    <!-- ===================================================== -->
    <select id="checkUserForReset" parameterType="hashmap" resultMap="userMap">
        SELECT
            user_id,
            user_name,
            phone
        FROM users
        WHERE user_id = #{userId}
          AND phone = #{phone}
    </select>

    <!-- ===================================================== -->
    <!-- 8. 비밀번호 변경 -->
    <!-- ===================================================== -->
    <update id="resetPwd" parameterType="hashmap">
        UPDATE users
        SET pwd = #{pwd}
        WHERE user_id = #{userId}
    </update>

</mapper>